{
  "name": "vibetrace",
  "displayName": "VibeTrace",
  "description": "Vibe coding process chain recorder & visualizer — never lose context across agent windows",
  "version": "0.1.0",
  "publisher": "vibetrace",
  "author": {
    "name": "zpeakj"
  },
  "license": "MIT",
  "homepage": "https://github.com/zpeakj/vibe-trace",
  "repository": {
    "type": "git",
    "url": "https://github.com/zpeakj/vibe-trace"
  },
  "bugs": {
    "url": "https://github.com/zpeakj/vibe-trace/issues"
  },
  "icon": "res/logo.png",
  "keywords": [
    "vibe-coding",
    "trace",
    "manage vibe-coding project"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibetrace",
          "title": "VibeTrace",
          "icon": "res/logo.svg"
        }
      ]
    },
    "views": {
      "vibetrace": [
        {
          "id": "vibetrace.globalTimeline",
          "name": "Global Timeline",
          "icon": "$(history)"
        },
        {
          "id": "vibetrace.featureGraph",
          "name": "Business Features",
          "icon": "$(organization)"
        },
        {
          "id": "vibetrace.sessionChain",
          "name": "Window Sessions",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vibetrace.globalTimeline",
        "contents": "## VibeTrace — Not Active\n\nAI conversation tracing is not yet set up for this project.\n\n[🚀 Initialize VibeTrace](command:vibetrace.initialize)\n\n---\n\nAfter initialization, AI agents will auto-record every code-change conversation into `.vibe/events/`. You'll see them here as a live timeline.",
        "when": "!vibetrace:initialized"
      },
      {
        "view": "vibetrace.featureGraph",
        "contents": "## VibeTrace — Not Active\n\nBusiness feature tracking is not yet set up.\n\n[🚀 Initialize VibeTrace](command:vibetrace.initialize)\n\n---\n\nAfter initialization, AI will auto-classify conversations into feature modules. You'll see a visual graph of how features evolve.",
        "when": "!vibetrace:initialized"
      },
      {
        "view": "vibetrace.sessionChain",
        "contents": "## VibeTrace — Not Active\n\nSession tracing is not yet set up.\n\n[🚀 Initialize VibeTrace](command:vibetrace.initialize)\n\n---\n\nAfter initialization, each agent window's conversation will appear as a separate session chain.",
        "when": "!vibetrace:initialized"
      }
    ],
    "commands": [
      {
        "command": "vibetrace.refresh",
        "title": "VibeTrace: Refresh Views",
        "icon": "$(refresh)"
      },
      {
        "command": "vibetrace.openFile",
        "title": "VibeTrace: Open Impact File"
      },
      {
        "command": "vibetrace.editModule",
        "title": "VibeTrace: Edit Module Name"
      },
      {
        "command": "vibetrace.viewDetail",
        "title": "VibeTrace: View Event Detail",
        "icon": "$(eye)"
      },
      {
        "command": "vibetrace.viewFeatureFlow",
        "title": "VibeTrace: View Feature Flowchart",
        "icon": "$(graph)"
      },
      {
        "command": "vibetrace.viewSessionChain",
        "title": "VibeTrace: View Session Chain",
        "icon": "$(list-tree)"
      },
      {
        "command": "vibetrace.renameSession",
        "title": "VibeTrace: Rename Session",
        "icon": "$(edit)"
      },
      {
        "command": "vibetrace.initialize",
        "title": "VibeTrace: Initialize",
        "icon": "$(rocket)"
      },
      {
        "command": "vibetrace.setupRules",
        "title": "VibeTrace: Setup AI Rules File",
        "icon": "$(gear)"
      },
      {
        "command": "vibetrace.copyRules",
        "title": "VibeTrace: Copy Cursor Rules to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "vibetrace.openDashboard",
        "title": "VibeTrace: Open Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "vibetrace.openTimeline",
        "title": "VibeTrace: Open Global Timeline",
        "icon": "$(history)"
      },
      {
        "command": "vibetrace.openBusinessTree",
        "title": "VibeTrace: Open Business Features",
        "icon": "$(organization)"
      },
      {
        "command": "vibetrace.openSessionFlow",
        "title": "VibeTrace: Open Window Sessions",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vibetrace.refresh",
          "when": "view == vibetrace.globalTimeline || view == vibetrace.featureGraph || view == vibetrace.sessionChain",
          "group": "navigation"
        },
        {
          "command": "vibetrace.openTimeline",
          "when": "view == vibetrace.globalTimeline",
          "group": "navigation"
        },
        {
          "command": "vibetrace.openBusinessTree",
          "when": "view == vibetrace.featureGraph",
          "group": "navigation"
        },
        {
          "command": "vibetrace.openSessionFlow",
          "when": "view == vibetrace.sessionChain",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vibetrace.viewDetail",
          "when": "viewItem == vibeEvent",
          "group": "inline"
        },
        {
          "command": "vibetrace.editModule",
          "when": "viewItem == vibeEvent",
          "group": "context@1"
        },
        {
          "command": "vibetrace.openFile",
          "when": "viewItem == impactFile",
          "group": "inline"
        },
        {
          "command": "vibetrace.renameSession",
          "when": "viewItem == sessionGroup",
          "group": "context@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "build:webview": "cd webview-ui && npm run build",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "sharp": "^0.34.5",
    "typescript": "^5.3.0"
  }
}
